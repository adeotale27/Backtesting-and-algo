[kite_login_details]
api_key = YOUR_API_KEY
api_secret = YOUR_API_SECRET

[option_details]
current_volatility = 13
interest_rate = 16

min_bank_nifty_delta = -3000
max_bank_nifty_delta = 1000
#default min_delta value is -1000 and +1000

min_nifty_delta = -2000 
max_nifty_delta = 2000 
#default min_delta value is -800 and +800

delta_calculation_days = 5 
#this is till when the options expiry to be calculated - These are business working days
#On Thursday this should be 10 only

[others]
cool_off_time = 10 
#default cool off time is 30 secs
order_gtt_regular = regular 
#order_gtt_regular is <gtt> or <regular>

[gatekeeper]
username = YOUR_USERNAME
password = YOUR_PASSWORD

[notifications]
# Base URL used for links inside Telegram / web-push notifications.
# Set to your dashboard's public URL if you access it remotely.
server_base_url = http://127.0.0.1:5010

[safety]
# DRY-RUN KILL SWITCH. With live_trading = false (the default for new
# installs), every order-placement call is simulated and logged — NOTHING is
# sent to Zerodha. Set to true only after you have verified your setup and
# understand that real money will be traded. If this key is absent entirely,
# live trading is assumed (legacy installs predating this section).
live_trading = false

[greeks]
# Greeks calculation backend: mibian | opengreeks
# opengreeks (pip install opengreeks) is a Rust-backed drop-in ~5-180x faster.
# Fail-loud: an invalid value or missing opengreeks package raises at startup.
library = mibian
# When true, compute BOTH backends on every call and log divergences beyond
# tolerance (primary backend values are still returned). Use before switching.
shadow_compare = false
# Base absolute tolerance for shadow comparison (delta units; prices use it
# as relative tolerance with a 0.05 abs floor; IV uses a fixed 0.25 pct-pts).
shadow_tolerance = 0.005
